# This project resolves ALL packages — unscoped AND every scoped package —
# from the official public npm registry only. No internal mirror, no token.
# Project-level @scope:registry entries here override any user-global
# @scope:registry with higher specificity, so a global config cannot silently
# redirect a scope to an internal source. Local install / CI may also pass
# --registry explicitly.
registry=https://registry.npmjs.org/

@adobe:registry=https://registry.npmjs.org/
@asamuzakjp:registry=https://registry.npmjs.org/
@babel:registry=https://registry.npmjs.org/
@csstools:registry=https://registry.npmjs.org/
@esbuild:registry=https://registry.npmjs.org/
@jridgewell:registry=https://registry.npmjs.org/
@napi-rs:registry=https://registry.npmjs.org/
@radix-ui:registry=https://registry.npmjs.org/
@rolldown:registry=https://registry.npmjs.org/
@rollup:registry=https://registry.npmjs.org/
@testing-library:registry=https://registry.npmjs.org/
@types:registry=https://registry.npmjs.org/
@vitejs:registry=https://registry.npmjs.org/
@vitest:registry=https://registry.npmjs.org/
