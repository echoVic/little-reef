    },
    "fieldBg": "#e7e5df",
    "fish": "#7FB2D6",
    "hoverBg": "#f0eee6",
    "menuIcon": "#33313B",
    "panelDeep": "#ebe9e2",
    "panelRaised": "#f8f6ed",
