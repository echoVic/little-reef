    "coral": {
      "color": "#F4B9C2",
      "stages": 3
    },
    "fieldBg": "#e9e6e0",
    "fish": "#F6C6A0",
    "hoverBg": "#f2eee8",
    "menuIcon": "#C4808E",
    "panelDeep": "#edeae4",
    "panelRaised": "#f8f5f0",
