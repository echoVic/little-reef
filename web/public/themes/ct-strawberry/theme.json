    "bgGlow": "#f1e4e7",
    "bgGradient": "#F6D9E0",
    "bubble": "#FFFFFF",
    "controlBg": "#FFFDF9",
    "controlBorder": "#EBD3D8",
    "coral": {
      "color": "#F29CAB",
      "stages": 3
    },
    "fieldBg": "#eae5e2",
    "fish": "#FFF4E3",
    "hoverBg": "#f3eeeb",
    "menuIcon": "#B85365",
    "panelDeep": "#eee9e6",
    "panelRaised": "#f9f5f2",
    "popBg": "#fffefc",
    "ringTrack": "#f3e4e5",
    "sand": "#F7E6C8",
    "seaweed": {
      "color": "#F2AEBB",
      "stages": 3
