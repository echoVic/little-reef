{
  "meta": {
    "themeId": "cm-pop",
    "displayName": "波普",
    "styleFamily": "cartoon",
    "version": "1.0.0",
    "minAppVersion": "0.5.0",
    "supportsDarkAppearance": false,
    "reduceMotionFallback": "static idle frame"
  },
  "tokens": {
    "bgBase": "#8FDDE0",
    "bgGradient": "#C6F2EF",
    "waterLight": "#FFFFFF",
    "sand": "#F6E7C6",
    "coral": {
      "color": "#F4703E",
      "stages": 3
    },
    "fish": "#F27EA9",
    "seaweed": {
      "color": "#67C58F",
      "stages": 3
    },
    "bubble": "#FFFFFF",
    "accent": "#F4703E",
    "timerActive": "#F4703E",
    "timerPause": "#7C93A6",
    "controlBg": "#FFFDF7",
    "controlBorder": "#1D3557",
    "textPrimary": "#1D3557",
    "textSecondary": "#517084",
    "menuIcon": "#F27EA9"
  },
  "motion": {
    "bubbleDensity": 0.33,
    "driftSpeed": 0.33,
    "easing": "cubic-bezier(0.33,0,0.15,1)"
  },
  "ambientAudio": {
    "defaultOn": false,
    "maxVolume": 0.2
  },
  "controls": {
    "radius": "16px",
    "borderWidth": "1px"
  },
  "fonts": {
    "title": "ZCOOL KuaiLe, PingFang SC",
    "body": "inherit",
    "digits": "SF Pro Rounded, SF Pro Text"
  },
  "behavior": {
    "maxCreatures": 5
  },
  "creaturePalette": {
    "fish": "#F27EA9"
  }
}
