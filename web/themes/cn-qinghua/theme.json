{
  "meta": {
    "themeId": "cn-qinghua",
    "displayName": "青花瓷韵",
    "styleFamily": "chinese",
    "version": "1.0.0",
    "minAppVersion": "0.5.0",
    "supportsDarkAppearance": false,
    "reduceMotionFallback": "fish docked, plants still"
  },
  "tokens": {
    "bgBase": "#EFF4F7",
    "bgGradient": "#C9DAE5",
    "waterLight": "#FBFDFE",
    "sand": "#D8C2A4",
    "coral": {
      "color": "#24567F",
      "stages": 3
    },
    "fish": "#2E6BA0",
    "seaweed": {
      "color": "#7FA3B8",
      "stages": 3
    },
    "bubble": "#FFFFFF",
    "accent": "#235E8C",
    "timerActive": "#3D7EA6",
    "timerPause": "#97744B",
    "controlBg": "#F8FBFD",
    "controlBorder": "#9DB8CA",
    "textPrimary": "#1F3A4D",
    "textSecondary": "#566F82",
    "menuIcon": "#1F3A4D"
  },
  "motion": {
    "bubbleDensity": 0.5,
    "driftSpeed": 0.5,
    "easing": "cubic-bezier(0.4,0,0.25,1)"
  },
  "ambientAudio": {
    "defaultOn": false,
    "maxVolume": 0.2
  },
  "controls": {
    "radius": "10px",
    "borderWidth": "1px"
  },
  "fonts": {
    "title": "Songti SC, Source Han Serif SC, serif",
    "body": "inherit",
    "digits": "SF Mono, Menlo"
  },
  "behavior": {
    "maxCreatures": 3
  },
  "creaturePalette": {
    "fish": "#2E6BA0"
  }
}
