{
  "meta": {
    "themeId": "cn-qinglu",
    "displayName": "青绿江山",
    "styleFamily": "chinese",
    "version": "1.0.0",
    "minAppVersion": "0.5.0",
    "supportsDarkAppearance": false,
    "reduceMotionFallback": "fish held at depth"
  },
  "tokens": {
    "bgBase": "#EAE2C6",
    "bgGradient": "#B5C6A9",
    "waterLight": "#FBFAF3",
    "sand": "#D9BC74",
    "coral": {
      "color": "#3F7A5F",
      "stages": 3
    },
    "fish": "#A8563A",
    "seaweed": {
      "color": "#5C8A63",
      "stages": 3
    },
    "bubble": "#FFFFFF",
    "accent": "#3F755B",
    "timerActive": "#2F6D74",
    "timerPause": "#8F5F3C",
    "controlBg": "#F7F3E3",
    "controlBorder": "#BFB79E",
    "textPrimary": "#3A342B",
    "textSecondary": "#66604E",
    "menuIcon": "#3A342B"
  },
  "motion": {
    "bubbleDensity": 0.4,
    "driftSpeed": 0.4,
    "easing": "cubic-bezier(0.38,0,0.22,1)"
  },
  "ambientAudio": {
    "defaultOn": false,
    "maxVolume": 0.2
  },
  "controls": {
    "radius": "12px",
    "borderWidth": "1px"
  },
  "fonts": {
    "title": "Songti SC, Source Han Serif SC, serif",
    "body": "inherit",
    "digits": "SF Mono, Menlo"
  },
  "behavior": {
    "maxCreatures": 5
  },
  "creaturePalette": {
    "fish": "#A8563A"
  }
}
