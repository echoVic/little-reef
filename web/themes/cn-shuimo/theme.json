{
  "meta": {
    "themeId": "cn-shuimo",
    "displayName": "水墨兰亭",
    "styleFamily": "chinese",
    "version": "1.0.0",
    "minAppVersion": "0.5.0",
    "supportsDarkAppearance": false,
    "reduceMotionFallback": "dock fish, vertical plants"
  },
  "tokens": {
    "bgBase": "#F1ECE1",
    "bgGradient": "#DCD5C4",
    "waterLight": "#FBF8F0",
    "sand": "#D9CDB2",
    "coral": {
      "color": "#3A362F",
      "stages": 3
    },
    "fish": "#2B2722",
    "seaweed": {
      "color": "#6E6A5C",
      "stages": 3
    },
    "bubble": "#FFFFFF",
    "accent": "#B4533C",
    "timerActive": "#4E6E5D",
    "timerPause": "#8F6F45",
    "controlBg": "#FAF7EF",
    "controlBorder": "#C6BFAE",
    "textPrimary": "#33302B",
    "textSecondary": "#6E6959",
    "menuIcon": "#33302B"
  },
  "motion": {
    "bubbleDensity": 0.2,
    "driftSpeed": 0.3,
    "easing": "cubic-bezier(0.33,0,0.2,1)"
  },
  "ambientAudio": {
    "defaultOn": false,
    "maxVolume": 0.2
  },
  "controls": {
    "radius": "10px",
    "borderWidth": "1px"
  },
  "fonts": {
    "title": "Kaiti SC, LXGW WenKai, Songti SC, serif",
    "body": "inherit",
    "digits": "SF Mono, Menlo"
  },
  "behavior": {
    "maxCreatures": 3
  },
  "creaturePalette": {
    "fish": "#2B2722"
  }
}
