{
  "meta": {
    "themeId": "ct-cream",
    "displayName": "马卡龙",
    "styleFamily": "cute",
    "version": "1.0.0",
    "minAppVersion": "0.5.0",
    "supportsDarkAppearance": false,
    "reduceMotionFallback": "frozen illustration"
  },
  "tokens": {
    "bgBase": "#FBF4E9",
    "bgGradient": "#F2E3CF",
    "waterLight": "#D8EEDF",
    "sand": "#EFDDBE",
    "coral": { "color": "#F4B9C2", "stages": 3 },
    "fish": "#F6C6A0",
    "seaweed": { "color": "#A9D6BE", "stages": 3 },
    "bubble": "#FFFFFF",
    "accent": "#C4798D",
    "timerActive": "#4F8E6F",
    "timerPause": "#C99A4E",
    "controlBg": "#FFFDF8",
    "controlBorder": "#E3D2BC",
    "textPrimary": "#4B3A32",
    "textSecondary": "#7A6555",
    "menuIcon": "#C4808E"
  },
  "motion": { "bubbleDensity": 0.4, "driftSpeed": 0.5, "easing": "cubic-bezier(0.42,0,0.58,1)" },
  "ambientAudio": { "defaultOn": false, "maxVolume": 0.2 }
}
