{
  "meta": {
    "themeId": "reef-realistic",
    "displayName": "深海写实",
    "styleFamily": "realistic",
    "version": "1.0.0",
    "minAppVersion": "0.5.0",
    "supportsDarkAppearance": true,
    "reduceMotionFallback": "static-poses"
  },
  "tokens": {
    "bgBase": "#0c1820",
    "bgGradient": "#102e3a",
    "waterLight": "#194250",
    "sand": "#718371",
    "coral": { "color": "#bd918c", "stages": 3 },
    "fish": "#a8deba",
    "seaweed": { "color": "#529a86", "stages": 3 },
    "bubble": "#b4cfb1",
    "accent": "#a8deba",
    "timerActive": "#a8deba",
    "timerPause": "#e6b48b",
    "controlBg": "#12232b",
    "controlBorder": "#254047",
    "textPrimary": "#e3ede9",
    "textSecondary": "#8ca7a7",
    "menuIcon": "#a8deba"
  },
  "motion": {
    "bubbleDensity": 1,
    "driftSpeed": 1,
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "ambientAudio": {
    "defaultOn": false,
    "maxVolume": 0.2
  }
}
